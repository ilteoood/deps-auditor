#!/usr/bin/env node
'use strict'

const { readFileSync } = require('node:fs')
const { parseChangelogOverrides } = require('./lib/cli')
const { readRepositoryUrl } = require('./lib/forges')
const { collectNotes } = require('./lib/notes')
const { github, https } = require('./lib/transport')

async function main() {
	const overrides = parseChangelogOverrides(process.argv.slice(2))
	const input = readFileSync(0, 'utf8').trim()
	if (input === '') throw new Error('expected the audit JSON on stdin (pipe audit-deps output)')

	const options = { overrides, transport: { github, https }, readRepositoryUrl }
	const { changes } = JSON.parse(input)
	const results = []
	for (const change of changes ?? []) results.push(await collectNotes(change, options))

	process.stdout.write(`${JSON.stringify({ results }, null, 2)}\n`)
}

main().catch((error) => {
	process.stderr.write(`fetch-changelog: ${error.message}\n`)
	process.exit(1)
})
